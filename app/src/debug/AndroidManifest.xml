<?xml version="1.0" encoding="utf-8"?>
<!-- 디버그 빌드에만 들어가는 시연 도구(DebugReceiver 참조). 출시 빌드에는 없다 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="haengcha.app.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
