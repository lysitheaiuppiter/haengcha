<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 지역 테마와 어린이보호구역 판정. 좌표는 저장하지 않는다 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 화면을 닫아도 주행 기록과 위치 수신을 이어 가는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Pleos 음성 엔진(ai.pleos.playground.caas)이 TTS 서비스 연결에 요구하는 일반 권한 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Android 11부터 패키지 가시성 제한 때문에 TTS 엔진을 찾으려면 선언해야 한다 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".HaengchaApp"
        android:icon="@mipmap/ic_launcher"
        android:label="행차"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true">
            <!-- 주행 규제 중에는 정적 정보 한 줄만 보여 주므로 주행 중 사용 대상으로 선언한다(기획서 9.1) -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CollectService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
